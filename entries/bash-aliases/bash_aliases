# ~/.bash_aliases — instalado por AppForge (receta bash-aliases).
# Lo carga ~/.bashrc y solo carga los fragmentos de ~/.bash_aliases.d/*.sh.
# Pon tus alias propios en ~/.bash_aliases.d/<nombre>.sh: la receta solo gestiona
# base.sh y eza.sh.

for _f in "$HOME"/.bash_aliases.d/*.sh; do
  [ -r "$_f" ] && . "$_f"
done
unset _f
